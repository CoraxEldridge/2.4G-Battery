<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>BatteryWidget</AssemblyName>
    <RootNamespace>BatteryWidget</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>2.4G Battery</Product>
    <Company>BatteryWidget</Company>
    <Description>查看 2.4G 无线键盘与触摸板电量</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- 自绘控件不参与 WinForms 设计器，关闭属性序列化分析器 -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BatteryWidget.Core\BatteryWidget.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内嵌思源系字体 Sarasa UI SC（Regular / SemiBold），启动时从内存加载，无需安装 -->
    <EmbeddedResource Include="Fonts\SarasaUiSC-Regular.ttf" LogicalName="BatteryWidget.Fonts.SarasaUiSC-Regular.ttf" />
    <EmbeddedResource Include="Fonts\SarasaUiSC-SemiBold.ttf" LogicalName="BatteryWidget.Fonts.SarasaUiSC-SemiBold.ttf" />
  </ItemGroup>

</Project>


